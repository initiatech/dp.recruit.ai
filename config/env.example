# App Configuration
APP_ENV=dev
APP_URL=http://localhost:8080

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recruiter_ai
DB_USERNAME=root
DB_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Voice Services Configuration
STT_PROVIDER=openai|google
TTS_PROVIDER=openai|elevenlabs
VOICE_ENABLED=true
AI_STREAMING=true
VAD_SENSITIVITY=0.6

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_SECRET=change_me_hmac

# Security & Feature Flags
PII_FILTER_ENABLED=true
RATE_LIMIT=20/min
JWT_SECRET=change_me_jwt
LINK_SECRET=change_me_link_secret
